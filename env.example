# Copy relevant keys into your environment / Secrets manager.
# ---- LLM (pick one provider; OpenAI shown) ----
OPENAI_API_KEY=

# ---- Alpaca broker (paper keys from alpaca.markets) ----
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Leave unset to use paper endpoint; set to https://api.alpaca.markets for live
# ALPACA_BASE_URL=

# ---- Guardrails ----
GA_TICKER_ALLOWLIST=AAPL,MSFT,NVDA,GOOGL,SPY
GA_MAX_POSITION_PCT=0.20
GA_MAX_ORDER_USD=2500
GA_MAX_DAILY_LOSS_PCT=0.03
GA_MAX_OPEN_POSITIONS=8

# ---- Runner ----
GA_TICKERS=AAPL,MSFT,NVDA
GA_INTERVAL_MIN=60
GA_MARKET_HOURS_ONLY=1

# ---- Decision source ----
# agents     = LLM multi-agent graph (requires OPENAI_API_KEY)
# strategies = quant + top-trader strategy board, no LLM needed
# blend      = agent decision combined with strategy board
GA_DECISION_SOURCE=agents

# ---- Live mode (double opt-in) ----
GA_LIVE_MODE=0
# GA_LIVE_MODE_CONFIRM=YES_I_UNDERSTAND_REAL_MONEY

# ---- Reporting (optional Discord ping) ----
# DISCORD_WEBHOOK_URL=

# ---- Misc ----
TRADINGAGENTS_RESULTS_DIR=./results
GA_JOURNAL_DB=./results/autonomous_journal.db
